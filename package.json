{
  "name": "bufferflow",
  "version": "1.0.0",
  "description": "High-throughput ingress gateway, shock-absorbing queue buffer, dynamic worker pool with circuit breaking & DLQ",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development bun --watch src/index.ts",
    "dev:ui": "NODE_ENV=development vite",
    "build": "NODE_ENV=production vite build",
    "start": "NODE_ENV=production bun run src/index.ts",
    "test": "NODE_ENV=test BUFFERFLOW_DISABLE_DB=1 bun test",
    "typecheck": "bun check",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "sync:env": "bash scripts/sync-env.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:backfill:test-type": "bun run scripts/backfill-test-type.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "1.4.2",
    "@elysiajs/static": "1.4.10",
    "drizzle-orm": "0.45.2",
    "elysia": "1.4.30",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@dagrejs/dagre": "3.1.1",
    "@fontsource-variable/geist": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.0",
    "@types/dagre": "0.7.54",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "@xyflow/react": "12.11.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-kit": "0.31.10",
    "lucide-react": "1.38.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "shadcn": "4.19.1",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "vite": "8.2.2"
  },
  "packageManager": "bun@1.4.3"
}
