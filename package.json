{
  "name": "bufferflow",
  "version": "1.0.0",
  "description": "High-throughput ingress gateway, shock-absorbing queue buffer, dynamic worker pool with circuit breaking & DLQ",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "dev:ui": "vite",
    "build": "vite build",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "elysia": "latest",
    "@elysiajs/cors": "latest",
    "@elysiajs/static": "latest"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@tailwindcss/vite": "latest",
    "@types/bun": "latest",
    "tailwindcss": "latest",
    "vite": "latest"
  }
}
