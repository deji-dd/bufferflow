# Bufferflow environment configuration
# Copy to .env (or .env.development) and adjust as needed.

PORT=3001
BUFFERFLOW_PORT=3001
NODE_ENV=development

# PostgreSQL (optional; the app falls back to in-memory history when unavailable)
# For Unix-socket IPC use the socket directory, e.g. /tmp (Homebrew) or
# /var/run/postgresql (Debian/container).
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=bufferflow_db
POSTGRES_USER=bufferflow_user
POSTGRES_PASSWORD=change-me

# Optional full connection string. Takes precedence over the POSTGRES_* fields.
# DATABASE_URL=postgresql://bufferflow_user:change-me@127.0.0.1:5432/bufferflow_db

# Apply migrations on startup even in development (production always applies them).
# RUN_MIGRATIONS=false

# Set to 1 to force in-memory history storage (used by the test suite).
# BUFFERFLOW_DISABLE_DB=1

# Optional control-plane authentication. When set, every /api/* endpoint and
# the /ws upgrade require a matching bearer token (or ?token= for WebSockets).
# Leave unset for local development.
# BUFFERFLOW_API_TOKEN=change-me-to-a-long-random-string

# Maximum request body size in bytes (default 1 MiB). Applies to the Bun server
# and to API requests that declare a Content-Length.
# BUFFERFLOW_MAX_BODY_BYTES=1048576
